<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBlack"
    android:clipToPadding="false"
    android:clipChildren="false"
    tools:context=".ui.schedule.fragment.ScheduleAnimeFragment">

    <View
        android:id="@+id/schedule_status_bar_placeholder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen2"
        android:background="@drawable/background_status_bar"
        android:elevation="0dp"
        android:outlineProvider="none"
        android:translationZ="0dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_status_bar"
        app:layout_constraintTop_toBottomOf="@id/schedule_status_bar_placeholder"
        >

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="scrollable"
            app:tabMaxWidth="@dimen/dimen159"
            app:tabMinWidth="@dimen/dimen135"
            android:layout_margin="@dimen/dimen8"
            app:tabBackground="@drawable/tabs_selector"
            app:tabIndicator="@null"
            android:background="@drawable/gradient_black_reverse"
            app:tabSelectedTextColor="@color/colorWhite"
            app:tabTextColor="@color/colorBlack"
            />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen0"
        app:layout_constraintTop_toBottomOf="@id/abl_schedule"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/dimen6"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.constraintlayout.widget.ConstraintLayout>
