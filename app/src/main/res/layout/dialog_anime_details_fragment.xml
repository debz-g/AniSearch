<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_anime_banner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_fragment_banner_height"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_mal_link"
        style="@style/MyMaterialFilledWhiteButton42"
        android:layout_width="0dp"
        android:layout_marginVertical="@dimen/dimen20"
        android:layout_marginStart="@dimen/dimen16"
        android:layout_marginEnd="@dimen/dimen16"
        android:text="@string/watch_trailer"
        android:visibility="visible"
        app:icon="@drawable/ic_youtube_16"
        app:iconTint="@color/colorRedPink"
        app:iconGravity="textStart"
        app:layout_constraintEnd_toStartOf="@id/mb_watch_trailer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_anime_banner" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mb_watch_trailer"
        style="@style/MyMaterialFilledWhiteButton42"
        android:layout_width="0dp"
        android:layout_marginVertical="@dimen/dimen20"
        android:layout_marginEnd="@dimen/dimen16"
        android:text="@string/watch_trailer"
        android:visibility="visible"
        app:icon="@drawable/ic_mal_14"
        app:iconTint="@color/colorBlue"
        app:iconGravity="textStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/mb_mal_link"
        app:layout_constraintTop_toBottomOf="@id/iv_anime_banner" />

</androidx.constraintlayout.widget.ConstraintLayout>